{
  "name": "dinkhub",
  "version": "0.1.0",
  "private": true,
  "description": "DinkHub — pickleball court booking marketplace (Philippines)",
  "scripts": {
    "dev": "pnpm --filter @dinkhub/web dev",
    "build": "pnpm --filter @dinkhub/web build",
    "start": "pnpm --filter @dinkhub/web start",
    "lint": "pnpm --filter @dinkhub/web lint",
    "typecheck": "pnpm --filter @dinkhub/web typecheck",
    "test": "pnpm --filter @dinkhub/web test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.0.9",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli"
    ]
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.0.3"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,mjs,cjs}": [
      "pnpm --filter @dinkhub/web exec eslint --fix --max-warnings=0"
    ]
  }
}
